---
import { SITE_CONFIG } from '../config';

export interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
}

const { slot = "1234567890", format = "auto" } = Astro.props;
const client = SITE_CONFIG.adsense.client;
---

<div class="ad-container" style="margin: 32px 0; text-align: center;">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client={client}
       data-ad-slot={slot}
       data-ad-format={format}
       data-full-width-responsive="true">
  </ins>
</div>
