---
export interface Props {
  minimum?: string;
  recommended?: string;
}

const { minimum, recommended } = Astro.props;

if (!minimum && !recommended) return null;
---

<div style="margin: 32px 0;">
  <div style="font-family: var(--mono); font-size: 12px; color: var(--cyan); text-transform: uppercase; margin-bottom: 12px;">
    // SYSTEM REQUIREMENTS & HARDWARE TARGETS
  </div>
  
  <table class="specs-table">
    <thead>
      <tr>
        <th>Tier</th>
        <th>Hardware Requirements</th>
      </tr>
    </thead>
    <tbody>
      {minimum && (
        <tr>
          <td style="font-family: var(--mono); color: var(--text-muted);">MINIMUM SPEC</td>
          <td>{minimum}</td>
        </tr>
      )}
      {recommended && (
        <tr>
          <td style="font-family: var(--mono); color: var(--cyan);">RECOMMENDED SPEC</td>
          <td>{recommended}</td>
        </tr>
      )}
    </tbody>
  </table>
</div>
