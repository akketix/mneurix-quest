---
import Layout from '../../layouts/Layout.astro';
import GameFactCard from '../../components/GameFactCard.astro';
import HardwareSpecs from '../../components/HardwareSpecs.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, gameTitle, developer, genre, platforms, releaseWindow, heroImage, trailerId, impactScore, sourceUrl, specs, date } = post.data;

// Related articles (same genre, exclude current, latest 3)
const allPosts = await getCollection('news');
const related = allPosts
  .filter(p => p.data.genre === genre && p.slug !== post.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Article JSON-LD structured data
const publishedISO = new Date(date).toISOString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: publishedISO,
  dateModified: publishedISO,
  image: [heroImage],
  author: { '@type': 'Organization', name: 'MNEURIX' },
  publisher: {
    '@type': 'Organization',
    name: 'MNEURIX',
    logo: { '@type': 'ImageObject', url: 'https://mneurix.quest/favicon.svg' },
  },
  description: post.data.summary,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://mneurix.quest/news/${post.slug}` },
  articleSection: genre,
};

// BreadcrumbList JSON-LD
const genreLower = genre.toLowerCase();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mneurix.quest/' },
    { '@type': 'ListItem', position: 2, name: genre, item: `https://mneurix.quest/genre/${genreLower}` },
    { '@type': 'ListItem', position: 3, name: title, item: `https://mneurix.quest/news/${post.slug}` },
  ],
};

// Reading time estimate (200 wpm)
const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout title={`${title} — MNEURIX // QUEST`} description={post.data.summary} image={heroImage}>
  <article class="container" style="max-width: 860px;">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

    <header class="article-header">
      <nav style="font-family: var(--mono); font-size: 12px; color: var(--text-muted); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <a href="/" style="color: var(--cyan); text-decoration: none;">ALL INTEL</a>
        <span style="color: var(--text-muted);">/</span>
        <a href={`/genre/${genreLower}`} style="color: var(--cyan); text-decoration: none;">{genre}</a>
        <span style="color: var(--text-muted);">/</span>
        <span style="color: var(--text-body);">{title}</span>
      </nav>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span class={`tech-pill ${genre.toLowerCase()}`}>{genre}</span>
        <span style="font-family: var(--mono); font-size: 12px; color: var(--text-muted);">
          PUBLISHED {new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
        <span style="font-family: var(--mono); font-size: 12px; color: var(--text-muted); opacity: 0.7;">
          · {readingTime} MIN READ
        </span>
      </div>

      <h1>{title}</h1>

      <div style="border-radius: 12px; overflow: hidden; border: 1px solid var(--border); margin: 24px 0; max-height: 440px;">
        <img src={heroImage} alt={gameTitle} style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
    </header>

    <GameFactCard
      gameTitle={gameTitle}
      developer={developer}
      genre={genre}
      platforms={platforms}
      releaseWindow={releaseWindow}
      impactScore={impactScore}
      sourceUrl={sourceUrl}
    />

    {trailerId && (
      <div style="margin: 32px 0;">
        <div style="font-family: var(--mono); font-size: 12px; color: var(--cyan); text-transform: uppercase; margin-bottom: 12px;">
          // OFFICIAL ANNOUNCEMENT TRAILER
        </div>
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 10px; border: 1px solid var(--border);">
          <iframe 
            src={`https://www.youtube.com/embed/${trailerId}`}
            title={`${gameTitle} Trailer`}
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
      </div>
    )}

    {specs && <HardwareSpecs minimum={specs.minimum} recommended={specs.recommended} />}

    <div class="article-body">
      <Content />
    </div>

    {related.length > 0 && (
      <section style="margin: 40px 0;">
        <div style="font-family: var(--mono); font-size: 12px; color: var(--cyan); text-transform: uppercase; margin-bottom: 16px;">
          // RELATED INTEL
        </div>
        <div class="news-grid">
          {related.map(p => (
            <a href={`/news/${p.slug}`} class="news-card" style="padding: 20px; gap: 8px;">
              <span class={`tech-pill ${p.data.genre.toLowerCase()}`}>{p.data.genre}</span>
              <h3 style="font-size: 16px; color: var(--text-heading); line-height: 1.35; margin: 4px 0 6px;">{p.data.title}</h3>
              <p style="color: var(--text-muted); font-size: 13px; flex-grow: 1;">{p.data.summary}</p>
              <div style="font-family: var(--mono); font-size: 11px; color: var(--text-muted); margin-top: 8px; display: flex; justify-content: space-between;">
                <span>{p.data.developer}</span>
                <span style="color: var(--cyan);">IMPACT {p.data.impactScore}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <GiscusComments />

  </article>
</Layout>
